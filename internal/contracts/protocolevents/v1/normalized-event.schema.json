{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loramapr.dev/contracts/protocol-events/v1/normalized-event.schema.json",
  "title": "LoRaMapr normalized receiver event v1",
  "type": "object",
  "required": [
    "contractVersion",
    "deliveryId",
    "eventType",
    "protocol",
    "receiver",
    "capabilities",
    "source"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "protocol": {
      "enum": ["meshtastic", "meshcore"]
    },
    "receiver": {
      "type": "object",
      "required": ["installationId", "adapter", "adapterVersion", "observedAt"],
      "properties": {
        "receiverAgentId": { "type": "string", "format": "uuid" },
        "installationId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "adapter": { "type": "string", "minLength": 1, "maxLength": 120 },
        "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "subject": {
      "type": "object",
      "required": ["protocolNamespace", "canonicalId", "verification"],
      "properties": {
        "protocolNamespace": { "type": "string", "minLength": 1, "maxLength": 120 },
        "canonicalId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "displayId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "verification": { "enum": ["verified", "unverified", "unattributable"] }
      }
    },
    "occurredAt": {
      "type": "object",
      "required": ["value", "origin"],
      "properties": {
        "value": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "origin": { "enum": ["protocol", "receiver", "unknown"] }
      }
    },
    "radio": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["kind", "value", "unit", "origin"],
            "properties": {
              "kind": { "enum": ["rssi", "snr"] },
              "value": { "type": "number" },
              "unit": { "enum": ["dBm", "dB"] },
              "origin": { "enum": ["receiver_local", "peer_reported"] },
              "source": {
                "type": "object",
                "required": ["value", "unit", "encoding"],
                "properties": {
                  "value": { "type": "number" },
                  "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "encoding": { "enum": ["identity", "meshcore_snr_x4"] }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "type": "object",
                      "properties": { "encoding": { "const": "meshcore_snr_x4" } },
                      "required": ["encoding"]
                    }
                  },
                  "required": ["source"]
                },
                "then": {
                  "properties": {
                    "kind": { "const": "snr" },
                    "source": {
                      "type": "object",
                      "properties": {
                        "value": { "type": "integer" },
                        "unit": { "const": "quarter_dB" }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "routeKind": { "enum": ["direct", "flood", "unknown"] },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "anyOf": [
        { "properties": { "metrics": true }, "required": ["metrics"] },
        { "properties": { "routeKind": true }, "required": ["routeKind"] },
        { "properties": { "path": true }, "required": ["path"] }
      ],
      "dependentRequired": {
        "path": ["routeKind"]
      }
    },
    "position": {
      "type": "object",
      "required": ["lat", "lon", "verification"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "altM": { "type": "number" },
        "quality": { "type": "object" },
        "verification": { "enum": ["verified", "unverified"] }
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["samples"],
      "properties": {
        "samples": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["name", "value", "quality"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "value": {
                "oneOf": [
                  { "type": "number" },
                  { "type": "string" },
                  { "type": "boolean" }
                ]
              },
              "unit": { "type": "string", "maxLength": 40 },
              "quality": { "enum": ["reported", "derived"] }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "enum": ["available", "unavailable", "not_observable", "unknown"]
      }
    },
    "source": {
      "type": "object",
      "required": ["rawEncoding", "raw", "rawSha256"],
      "properties": {
        "protocolVersion": { "type": "string", "maxLength": 120 },
        "nativeMessageType": {
          "oneOf": [{ "type": "string" }, { "type": "number" }]
        },
        "nativeMessageId": { "type": "string", "maxLength": 512 },
        "rawEncoding": { "const": "base64" },
        "raw": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contentKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "replay": {
      "type": "object",
      "properties": {
        "batchId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "originalObservedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }
      }
    }
  }
}
