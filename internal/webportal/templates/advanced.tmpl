{{define "content"}}
<section class="lmr-card">
  <h2 class="lmr-card__title">Advanced Details</h2>
  <p class="lmr-card__desc">Use this page for support/debug metadata. Most setup tasks are handled in Pairing, Progress, and Troubleshooting.</p>
  <div class="lmr-kv lmr-kv--wide">
    <div class="lmr-kv__row"><div class="lmr-kv__label">Installation ID</div><div><span class="lmr-mono">{{if .Snapshot.InstallationID}}{{.Snapshot.InstallationID}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Local Receiver Name</div><div>{{if .Snapshot.LocalName}}{{.Snapshot.LocalName}}{{else}}unnamed{{end}}</div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Hostname</div><div><span class="lmr-mono">{{if .Snapshot.Hostname}}{{.Snapshot.Hostname}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Cloud Receiver ID</div><div><span class="lmr-mono">{{if .Snapshot.CloudReceiverID}}{{.Snapshot.CloudReceiverID}}{{else}}not assigned{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Cloud Receiver Name</div><div>{{if .Snapshot.CloudReceiverLabel}}{{.Snapshot.CloudReceiverLabel}}{{else}}not assigned{{end}}</div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Optional Cloud Labels</div><div>{{if or .Snapshot.CloudSiteLabel .Snapshot.CloudGroupLabel}}site={{if .Snapshot.CloudSiteLabel}}{{.Snapshot.CloudSiteLabel}}{{else}}not set{{end}}, group={{if .Snapshot.CloudGroupLabel}}{{.Snapshot.CloudGroupLabel}}{{else}}not set{{end}}{{else}}none{{end}}</div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Runtime Version</div><div><span class="lmr-mono">{{.RuntimeVersion}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Release Channel</div><div><span class="lmr-mono">{{.ReleaseChannel}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Build Commit</div><div><span class="lmr-mono">{{if .BuildCommit}}{{.BuildCommit}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Build Date</div><div><span class="lmr-mono">{{if .BuildDate}}{{.BuildDate}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Build ID</div><div><span class="lmr-mono">{{if .BuildID}}{{.BuildID}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Go Version</div><div><span class="lmr-mono">{{.GoVersion}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Platform</div><div><span class="lmr-mono">{{.Platform}}/{{.Arch}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Install Type</div><div><span class="lmr-mono">{{if .InstallType}}{{.InstallType}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Service Mode</div><div><span class="lmr-pill {{lmrTone .Snapshot.Mode}}"><span class="lmr-pill__dot"></span>{{.Snapshot.Mode}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Runtime Profile</div><div><span class="lmr-mono">{{.Snapshot.RuntimeProfile}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Meshtastic Config Available</div><div><span class="lmr-pill {{lmrBoolTone .Snapshot.MeshtasticConfig.Available}}"><span class="lmr-pill__dot"></span>{{lmrBoolLabel .Snapshot.MeshtasticConfig.Available}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Meshtastic Region</div><div><span class="lmr-mono">{{if .Snapshot.MeshtasticConfig.Region}}{{.Snapshot.MeshtasticConfig.Region}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Meshtastic Primary Channel</div><div>{{if .Snapshot.MeshtasticConfig.PrimaryChannel}}{{.Snapshot.MeshtasticConfig.PrimaryChannel}}{{else}}unknown{{end}}</div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Meshtastic PSK State</div><div><span class="lmr-mono">{{if .Snapshot.MeshtasticConfig.PSKState}}{{.Snapshot.MeshtasticConfig.PSKState}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Meshtastic Share URL Available</div><div><span class="lmr-pill {{lmrBoolTone .Snapshot.MeshtasticConfig.ShareURLAvailable}}"><span class="lmr-pill__dot"></span>{{lmrBoolLabel .Snapshot.MeshtasticConfig.ShareURLAvailable}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Meshtastic Share URL (Redacted)</div><div><span class="lmr-mono">{{if .Snapshot.MeshtasticConfig.ShareURLRedacted}}{{.Snapshot.MeshtasticConfig.ShareURLRedacted}}{{else}}none{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Meshtastic Config Source</div><div><span class="lmr-mono">{{if .Snapshot.MeshtasticConfig.Source}}{{.Snapshot.MeshtasticConfig.Source}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Meshtastic Config Updated</div><div><span class="lmr-mono">{{if .Snapshot.MeshtasticConfig.UpdatedAt}}{{.Snapshot.MeshtasticConfig.UpdatedAt}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Update Status</div><div><span class="lmr-pill {{lmrTone .Snapshot.UpdateStatus}}"><span class="lmr-pill__dot"></span>{{if .Snapshot.UpdateStatus}}{{.Snapshot.UpdateStatus}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Recommended Version</div><div><span class="lmr-mono">{{if .Snapshot.UpdateRecommendedVersion}}{{.Snapshot.UpdateRecommendedVersion}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Manifest Channel</div><div><span class="lmr-mono">{{if .Snapshot.UpdateManifestChannel}}{{.Snapshot.UpdateManifestChannel}}{{else}}unknown{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Last Update Check</div><div><span class="lmr-mono">{{if .Snapshot.UpdateCheckedAt}}{{.Snapshot.UpdateCheckedAt}}{{else}}never{{end}}</span></div></div>
    <div class="lmr-kv__row"><div class="lmr-kv__label">Lifecycle</div><div><span class="lmr-pill {{lmrTone .Snapshot.Lifecycle}}"><span class="lmr-pill__dot"></span>{{.Snapshot.Lifecycle}}</span></div></div>
  </div>
</section>
<section class="lmr-card">
  <h2 class="lmr-card__title">Security Notes</h2>
  <p class="lmr-card__desc">This page intentionally omits stored API secrets and activation tokens. Meshtastic share values are shown only on local portal surfaces; redacted values are used for support exports and cloud status.</p>
</section>
{{end}}
