{{define "layout"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} - LoRaMapr Receiver</title>
  <script>
    (function(){try{var t=localStorage.getItem('lmr-theme');
    if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
  </script>
  <link rel="stylesheet" href="/static/css/tokens.css">
  <link rel="stylesheet" href="/static/css/portal.css">
</head>
<body class="lmr-app">
  <header class="lmr-bar" aria-label="LoRaMapr Receiver Setup Portal">
    <div class="lmr-bar__inner">
      <div class="lmr-bar__top">
        <div class="lmr-brand">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="17.5" r="1.8" fill="currentColor" stroke="none"></circle>
            <path d="M7.8 13.8a6 6 0 0 1 8.4 0"></path>
            <path d="M4.8 10.3a10.4 10.4 0 0 1 14.4 0"></path>
          </svg>
          <span><b>LoRaMapr</b> Receiver Setup Portal</span>
        </div>
        <div class="lmr-bar__right">
          <span class="lmr-version">v {{if .RuntimeVersion}}{{.RuntimeVersion}}{{else}}unknown{{end}}{{if .ReleaseChannel}} · {{.ReleaseChannel}}{{end}}</span>
          <button class="lmr-themebtn" type="button" data-lmr-theme-toggle title="Toggle light / dark" aria-label="Toggle light or dark theme">
            <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
              <path d="M8 1.6a6.4 6.4 0 0 0 0 12.8z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
      <nav class="lmr-nav">
        <a class="lmr-nav__tab {{lmrActive .Title "Welcome"}}" href="/">Welcome</a>
        <a class="lmr-nav__tab {{lmrActive .Title "Pairing"}}" href="/pairing">Pairing</a>
        <a class="lmr-nav__tab {{lmrActive .Title "Progress"}}" href="/progress">Progress</a>
        <a class="lmr-nav__tab {{lmrActive .Title "MeshCore"}}" href="/meshcore">MeshCore</a>
        <a class="lmr-nav__tab {{lmrActive .Title "Home Auto Session"}}" href="/home-auto-session">Home Auto Session</a>
        <a class="lmr-nav__tab {{lmrActive .Title "Troubleshooting"}}" href="/troubleshooting">Troubleshooting</a>
        <a class="lmr-nav__tab {{lmrActive .Title "Advanced"}}" href="/advanced">Advanced</a>
      </nav>
    </div>
  </header>
  <main class="lmr-main">
    {{template "content" .}}
  </main>
  <script>
    (function() {
      const autoRefreshPaths = new Set(["/", "/pairing", "/progress", "/troubleshooting", "/advanced"]);
      if (!autoRefreshPaths.has(window.location.pathname)) {
        return;
      }
      function ensureUpdateBanner() {
        let banner = document.getElementById("status-update-banner");
        if (banner) {
          return banner;
        }
        banner = document.createElement("div");
        banner.id = "status-update-banner";
        banner.className = "lmr-toast";
        banner.style.display = "none";
        banner.innerHTML = '<span class="lmr-toast__dot"></span><span id="status-update-text"></span><button id="status-update-refresh" class="lmr-btn lmr-btn--sm" type="button">Refresh</button>';
        document.body.appendChild(banner);
        const refreshButton = document.getElementById("status-update-refresh");
        if (refreshButton) {
          refreshButton.addEventListener("click", function() {
            window.location.reload();
          });
        }
        return banner;
      }

      function showUpdateBanner(updatedAt) {
        const banner = ensureUpdateBanner();
        const text = document.getElementById("status-update-text");
        if (text) {
          let suffix = "";
          if (updatedAt) {
            const parsed = new Date(updatedAt);
            if (!Number.isNaN(parsed.getTime())) {
              suffix = " (" + parsed.toLocaleTimeString() + ")";
            }
          }
          text.textContent = "Receiver status changed" + suffix + ".";
        }
        banner.style.display = "block";
      }

      function componentState(snapshot, name) {
        if (!snapshot || !snapshot.components || !snapshot.components[name]) {
          return "unknown";
        }
        return snapshot.components[name].state || "unknown";
      }

      function statusValueMap(snapshot) {
        const cloudLabel = (snapshot && snapshot.cloud_receiver_label) || "";
        const cloudID = (snapshot && snapshot.cloud_receiver_id) || "";
        const attentionState = (snapshot && snapshot.attention_state) || "none";
        const attentionCode = (snapshot && snapshot.attention_code) || "";
        let attentionStateCode = "none";
        if (attentionState && attentionState !== "none") {
          attentionStateCode = attentionState + (attentionCode ? (" " + attentionCode) : "");
        }
        return {
          local_name: (snapshot && snapshot.local_name) || "unnamed",
          cloud_receiver_display: cloudLabel || cloudID || "not assigned",
          pairing_phase: (snapshot && snapshot.pairing_phase) || "unknown",
          cloud_status: (snapshot && snapshot.cloud_status) || "unknown",
          cloud_endpoint: (snapshot && snapshot.cloud_endpoint) || "unknown",
          lifecycle: (snapshot && snapshot.lifecycle) || "unknown",
          ready: (snapshot && snapshot.ready) ? "yes" : "no",
          failure_code: (snapshot && snapshot.failure_code) || "none",
          update_status: (snapshot && snapshot.update_status) || "unknown",
          meshtastic_state: componentState(snapshot, "meshtastic"),
          network_state: componentState(snapshot, "network"),
          attention_state_code: attentionStateCode,
          last_error: (snapshot && snapshot.last_error) || "none"
        };
      }

      function applyStatusSnapshot(snapshot) {
        if (!snapshot || typeof snapshot !== "object") {
          return;
        }
        const values = statusValueMap(snapshot);
        const nodes = document.querySelectorAll("[data-status-key]");
        nodes.forEach(function(node) {
          const key = node.getAttribute("data-status-key");
          if (!key || !(key in values)) {
            return;
          }
          node.textContent = String(values[key]);
        });
      }

      if (typeof window.EventSource !== "function") {
        return;
      }

      let lastUpdatedAt = null;
      const source = new EventSource("/api/events/status");
      source.addEventListener("status", function(event) {
        if (!event || !event.data) {
          return;
        }
        let payload;
        try {
          payload = JSON.parse(event.data);
        } catch (_) {
          return;
        }
        const nextUpdatedAt = (payload && payload.updated_at) || null;
        if (!nextUpdatedAt) {
          return;
        }
        applyStatusSnapshot(payload);
        if (lastUpdatedAt === null) {
          lastUpdatedAt = nextUpdatedAt;
          return;
        }
        if (nextUpdatedAt !== lastUpdatedAt) {
          lastUpdatedAt = nextUpdatedAt;
          showUpdateBanner(nextUpdatedAt);
        }
      });
    })();
  </script>
  {{if eq .Title "MeshCore"}}<script src="/static/js/meshcore-dashboard.js"></script>{{end}}
  <script src="/static/js/theme-toggle.js"></script>
</body>
</html>
{{end}}
